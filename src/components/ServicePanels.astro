---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Panel { n: string; href: string; title: string; word: string; img: ImageMetadata; text: string }
interface Props { panels: Panel[] }
const { panels } = Astro.props;
---
<section id="services" class="overflow-hidden bg-ink text-white">
  <div id="services-track" class="flex h-[100svh] w-max flex-row motion-reduce:h-auto motion-reduce:w-full motion-reduce:flex-col">
    {panels.map((p) => (
      <a href={p.href} class="hpanel group relative block h-full w-screen shrink-0 overflow-hidden motion-reduce:h-[80svh] motion-reduce:w-full">
        <Picture src={p.img} alt={p.title} formats={['avif', 'webp']} widths={[480, 768, 1086]} sizes="100vw" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-transparent"></div>
        <div class="absolute inset-x-0 bottom-0">
          <div class="container-x pb-12 sm:pb-16">
            <p class="display text-[22vw] font-extrabold leading-none text-white/10 lg:text-[16vw]" aria-hidden="true">{p.word}</p>
            <div class="-mt-6 flex items-end justify-between gap-6 lg:-mt-10">
              <div>
                <p class="eyebrow text-frost">{p.n}</p>
                <h3 class="display mt-2 text-4xl font-extrabold leading-none sm:text-6xl">{p.title}</h3>
                <p class="mt-3 max-w-md text-white/75">{p.text}</p>
              </div>
              <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border border-white/40 transition-all duration-300 group-hover:rotate-[-45deg] group-hover:bg-red group-hover:border-red">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
