---
import { site, nav } from '../site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2" aria-label={`${site.name} home`}>
      <img src="/images/logo.png" alt={site.name} width="421" height="210" class="h-11 w-auto" />
    </a>
    <nav class="hidden items-center gap-6 md:flex" aria-label="Main">
      {nav.map((n) => (
        <a href={n.href} class:list={['text-sm font-semibold hover:text-red', isActive(n.href) ? 'text-red' : 'text-navy']}>{n.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-2">
      <a href={`tel:${site.phones[0].tel}`} class="btn-red hidden sm:inline-flex">Call {site.phones[0].display}</a>
      <button id="nav-toggle" class="rounded-md border border-slate-300 p-2 md:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="nav-mobile">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>
  <nav id="nav-mobile" class="hidden border-t border-slate-200 bg-white md:hidden" aria-label="Mobile">
    <div class="container-x flex flex-col py-2">
      {nav.map((n) => (
        <a href={n.href} class:list={['py-3 text-sm font-semibold', isActive(n.href) ? 'text-red' : 'text-navy']}>{n.label}</a>
      ))}
      <a href={`tel:${site.phones[0].tel}`} class="btn-red my-2">Call {site.phones[0].display}</a>
    </div>
  </nav>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-mobile');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
