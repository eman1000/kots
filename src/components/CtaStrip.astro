---
import { site, waLink } from '../site';
interface Props { heading?: string }
const { heading = "Let's get it sorted." } = Astro.props;
---
<section class="grain bg-ink text-white">
  <div class="container-x py-24 sm:py-32">
    <p class="eyebrow text-frost" data-reveal>Quotes &amp; call-outs</p>
    <h2 class="display mt-4 max-w-4xl text-[2rem] font-extrabold leading-[0.95] sm:text-6xl lg:text-7xl" data-reveal style="--d:80ms">{heading}</h2>
    <div class="mt-10 flex flex-wrap items-center gap-4" data-reveal style="--d:160ms">
      <a href={`tel:${site.phones[0].tel}`} class="btn-red !px-8 !py-4 !text-base">Call {site.phones[0].display}</a>
      <a href={waLink()} target="_blank" rel="noopener" class="btn-wa !px-8 !py-4 !text-base">WhatsApp</a>
      <a href="/contact/" class="btn-ghost !px-8 !py-4 !text-base">Send an enquiry</a>
    </div>
  </div>
</section>
