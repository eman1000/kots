---
import { site, waLink } from '../site';
interface Props { heading?: string }
const { heading = 'Need a quote or a call-out?' } = Astro.props;
---
<section class="bg-navy text-white">
  <div class="container-x flex flex-col items-start gap-6 py-12 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="text-2xl font-extrabold sm:text-3xl">{heading}</h2>
      <p class="mt-2 text-slate-200">Call, WhatsApp or send an enquiry. Based in {site.city}, available nationwide across {site.country}.</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={`tel:${site.phones[0].tel}`} class="btn-red">Call {site.phones[0].display}</a>
      <a href={waLink()} target="_blank" rel="noopener" class="btn-wa">WhatsApp</a>
      <a href="/contact/" class="btn-outline">Enquiry form</a>
    </div>
  </div>
</section>
