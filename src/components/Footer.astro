---
import { site, nav } from '../site';
const year = new Date().getFullYear();
---
<footer class="bg-navy-dark text-slate-200">
  <div class="container-x grid gap-10 py-12 md:grid-cols-3">
    <div>
      <img src="/images/logo.png" alt={site.name} width="421" height="210" class="h-12 w-auto rounded bg-white p-1" />
      <p class="mt-4 text-sm text-slate-300">{site.description}</p>
    </div>
    <div>
      <h3 class="text-sm font-bold uppercase tracking-wider text-white">Services</h3>
      <ul class="mt-3 space-y-2 text-sm">
        {nav.slice(1, 4).map((n) => <li><a href={n.href} class="hover:text-white">{n.label}</a></li>)}
        <li class="text-slate-400">Project coordination &amp; procurement support</li>
      </ul>
    </div>
    <div>
      <h3 class="text-sm font-bold uppercase tracking-wider text-white">Contact</h3>
      <ul class="mt-3 space-y-2 text-sm">
        {site.phones.map((p) => <li><a href={`tel:${p.tel}`} class="hover:text-white">{p.display}</a></li>)}
        <li><a href={`mailto:${site.email}`} class="hover:text-white">{site.email}</a></li>
        <li class="text-slate-400">Based in {site.city} • Available nationwide across {site.country}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-4 text-xs text-slate-400 sm:flex-row sm:justify-between">
      <span>© {year} {site.name}. All rights reserved.</span>
      <span>{site.tagline}</span>
    </div>
  </div>
</footer>
