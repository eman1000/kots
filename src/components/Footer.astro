---
import { Image } from 'astro:assets';
import { site, nav, waLink } from '../site';
import logoWhite from '../assets/logo-white.png';
const year = new Date().getFullYear();
---
<footer class="grain bg-ink text-white">
  <div class="container-x pt-20">
    <div class="grid gap-12 md:grid-cols-[1.2fr_1fr_1fr]">
      <div data-reveal>
        <Image src={logoWhite} alt={site.name} width={188} densities={[1, 2, 3]} class="mb-8 h-12 w-auto" />
        <p class="eyebrow text-frost">Get in touch</p>
        <a href={`tel:${site.phones[0].tel}`} class="display mt-4 block whitespace-nowrap text-3xl font-bold leading-none hover:text-frost sm:text-4xl">{site.phones[0].display}</a>
        <a href={`tel:${site.phones[1].tel}`} class="display mt-2 block whitespace-nowrap text-2xl font-bold text-white/60 hover:text-frost sm:text-3xl">{site.phones[1].display}</a>
        <a href={`mailto:${site.email}`} class="mt-5 inline-block text-white/70 underline-offset-4 hover:text-white hover:underline">{site.email}</a>
        <div class="mt-6 flex gap-3">
          <a href={waLink()} target="_blank" rel="noopener" class="btn-wa">WhatsApp</a>
          <a href="/contact/" class="btn-ghost">Enquiry form</a>
        </div>
      </div>
      <div data-reveal style="--d:100ms">
        <p class="eyebrow text-white/50">Services</p>
        <ul class="mt-4 space-y-3 text-lg">
          {nav.slice(1, 4).map((n) => <li><a href={n.href} class="hover:text-frost">{n.label}</a></li>)}
          <li class="text-white/50">Projects &amp; procurement support</li>
        </ul>
      </div>
      <div data-reveal style="--d:200ms">
        <p class="eyebrow text-white/50">Where</p>
        <p class="mt-4 text-lg">Based in {site.city}</p>
        <p class="text-white/60">Available for work nationwide across {site.country}</p>
        <p class="mt-6 text-sm text-white/50">{site.tagline}</p>
      </div>
    </div>
    <div class="mt-16 overflow-hidden border-t border-white/10 pt-6">
      <p class="display select-none text-[19vw] font-extrabold leading-[0.8] text-white/[0.06] md:text-[18vw]" aria-hidden="true">KOTS</p>
    </div>
    <div class="flex flex-col gap-2 py-6 text-xs text-white/40 sm:flex-row sm:justify-between">
      <span>© {year} {site.name}. All rights reserved.</span>
      <span>Harare, Zimbabwe</span>
    </div>
  </div>
</footer>
