---
import Base from '../layouts/Base.astro';
import CtaStrip from '../components/CtaStrip.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { site, waLink } from '../site';

const services = [
  { href: '/air-conditioning/', title: 'Air Conditioning & HVAC', img: '/images/aircon-install.jpg',
    text: 'Installation, replacement, servicing and maintenance for homes, cluster-home developments and larger buildings. Split systems, cassette units and other suitable configurations.' },
  { href: '/refrigeration/', title: 'Commercial Refrigeration', img: '/images/cold-room.jpg',
    text: 'Installation support, preventative maintenance, fault diagnosis and breakdown response for restaurants, hotels, supermarkets, butcheries, commercial kitchens and cold-storage facilities.' },
  { href: '/plumbing/', title: 'Plumbing', img: '/images/plumbing.jpg',
    text: 'New installations, renovations, repairs and ongoing maintenance for homes, cluster developments, commercial premises and building projects.' },
];
const clients = ['Residential property owners', 'Cluster-home developers', 'Property developers', 'Commercial buildings', 'Retail businesses', 'Hotels & restaurants', 'Supermarkets', 'Institutions', 'Facilities managers', 'Construction companies', 'Industrial & operational premises', 'Nationwide project support'];
const commitments = [
  { t: 'Professional service', d: 'Professional installation practices and project coordination across single units or whole developments.' },
  { t: 'Dependable response', d: 'Responsive maintenance and breakdown support to reduce equipment downtime.' },
  { t: 'Quality workmanship', d: 'Equipment positioning, refrigerant pipework, condensate drainage and electrical interface done properly.' },
  { t: 'Long-term relationships', d: 'Planned service programmes for developers, property managers and commercial sites.' },
];
---
<Base title="KOTS Group Investments — Air Conditioning, Refrigeration & Plumbing in Harare" description={`Air conditioning installation and repair, commercial refrigeration and plumbing in Harare and nationwide across Zimbabwe. Call ${site.phones[0].display}.`}>
  <section class="relative isolate overflow-hidden bg-navy-dark text-white">
    <img src="/images/cold-room.jpg" alt="" width="797" height="489" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-30" fetchpriority="high" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-dark via-navy-dark/90 to-navy-dark/40"></div>
    <div class="container-x py-20 sm:py-28">
      <p class="eyebrow text-red-300!">{site.tagline}</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-extrabold leading-tight sm:text-5xl lg:text-6xl">Reliable cooling, refrigeration and plumbing for Harare and beyond.</h1>
      <p class="mt-5 max-w-2xl text-lg text-slate-200">{site.name} installs, services and repairs air-conditioning, commercial refrigeration and plumbing systems for homes, developers and commercial premises. Based in {site.city}, we mobilise for projects nationwide.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`tel:${site.phones[0].tel}`} class="btn-red">Call {site.phones[0].display}</a>
        <a href={waLink()} target="_blank" rel="noopener" class="btn-wa">WhatsApp us</a>
        <a href="#enquiry" class="btn-outline">Get a quote</a>
      </div>
    </div>
  </section>

  <section class="container-x py-16">
    <p class="eyebrow">What we do</p>
    <h2 class="h2 mt-2">Three divisions, one responsive team</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {services.map((s) => (
        <a href={s.href} class="card group overflow-hidden p-0 transition hover:shadow-md">
          <img src={s.img} alt={s.title} width="800" height="500" loading="lazy" class="aspect-[16/10] w-full object-cover" />
          <div class="p-6">
            <h3 class="text-lg font-extrabold text-navy group-hover:text-red">{s.title}</h3>
            <p class="mt-2 text-sm text-slate-600">{s.text}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-red">Learn more →</span>
          </div>
        </a>
      ))}
    </div>
    <p class="mt-6 text-sm text-slate-600">We also provide project coordination and procurement &amp; supplies support alongside our field services.</p>
  </section>

  <section class="bg-ice">
    <div class="container-x grid gap-10 py-16 md:grid-cols-2 md:items-center">
      <div>
        <p class="eyebrow">Our commitment</p>
        <h2 class="h2 mt-2">Professional service, dependable response, quality workmanship.</h2>
        <dl class="mt-6 grid gap-5">
          {commitments.map((c) => (
            <div class="flex gap-3">
              <span class="mt-1 h-2.5 w-2.5 shrink-0 rounded-full bg-red"></span>
              <div><dt class="font-bold text-navy">{c.t}</dt><dd class="text-sm text-slate-600">{c.d}</dd></div>
            </div>
          ))}
        </dl>
      </div>
      <img src="/images/aircon-install.jpg" alt="KOTS technician servicing a wall-mounted air conditioner" width="524" height="770" loading="lazy" class="mx-auto max-h-[520px] rounded-xl object-cover shadow-md" />
    </div>
  </section>

  <section class="container-x py-16">
    <p class="eyebrow">Who we serve</p>
    <h2 class="h2 mt-2">From single homes to supermarkets and hotels</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {clients.map((c) => <li class="rounded-md border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-navy">{c}</li>)}
    </ul>
  </section>

  <CtaStrip />

  <section id="enquiry" class="container-x grid gap-10 py-16 md:grid-cols-5">
    <div class="md:col-span-2">
      <p class="eyebrow">Get a quote</p>
      <h2 class="h2 mt-2">Tell us what you need</h2>
      <p class="mt-3 text-slate-600">Send a few details and we will call you back. For urgent breakdowns, phone or WhatsApp us directly.</p>
      <ul class="mt-6 space-y-2 text-sm">
        {site.phones.map((p) => <li><a class="font-semibold text-navy hover:text-red" href={`tel:${p.tel}`}>{p.display}</a></li>)}
        <li><a class="font-semibold text-navy hover:text-red" href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
    <div class="card md:col-span-3"><EnquiryForm /></div>
  </section>
</Base>
