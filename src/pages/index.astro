---
import Base from '../layouts/Base.astro';
import CtaStrip from '../components/CtaStrip.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Marquee from '../components/Marquee.astro';
import Assemble from '../components/Assemble.astro';
import ServicePanels from '../components/ServicePanels.astro';
import { site, waLink } from '../site';

const headline = ['Keeping', 'Harare', 'cool,', 'cold', 'and', 'flowing.'];
const services = [
  { n: '01 — Cool', word: 'Cool', href: '/air-conditioning/', title: 'Air Conditioning', img: '/images/aircon.jpg',
    text: 'Install, service, repair — homes to large buildings.', tags: ['Split systems', 'Cassette units', 'Multi-unit developments'] },
  { n: '02 — Cold', word: 'Cold', href: '/refrigeration/', title: 'Commercial Refrigeration', img: '/images/coldroom.jpg',
    text: 'Cold rooms and commercial units that stay cold.', tags: ['Cold rooms', 'Breakdown response', 'Preventative maintenance'] },
  { n: '03 — Flowing', word: 'Flowing', href: '/plumbing/', title: 'Plumbing', img: '/images/plumbing.jpg',
    text: 'Installations, renovations, leaks, maintenance.', tags: ['Bathrooms & kitchens', 'Water supply pipework', 'Leaks & repairs'] },
];
const clients = ['Residential property owners', 'Cluster-home developers', 'Property developers', 'Commercial buildings', 'Retail businesses', 'Hotels & restaurants', 'Supermarkets', 'Institutions', 'Facilities managers', 'Construction companies', 'Industrial premises', 'Nationwide projects'];
const commitments = [
  { t: 'Professional service', d: 'Single units or whole developments.' },
  { t: 'Dependable response', d: 'Breakdowns answered. Downtime kept short.' },
  { t: 'Quality workmanship', d: 'Pipework, drainage, electrics — done properly.' },
  { t: 'Long-term relationships', d: 'Planned servicing for developers and property managers.' },
];
---
<Base theme="dark" title="KOTS Group Investments — Air Conditioning, Refrigeration & Plumbing in Harare" description={`Air conditioning installation and repair, commercial refrigeration and plumbing in Harare and nationwide across Zimbabwe. Call ${site.phones[0].display}.`}>
  <!-- HERO -->
  <section class="grain relative isolate flex min-h-[100svh] items-end overflow-hidden bg-ink text-white">
    <img src="/images/hero.jpg" alt="" width="1792" height="1024" class="absolute inset-0 -z-20 h-[120%] w-full object-cover" data-parallax="0.35" fetchpriority="high" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/70 to-ink/20"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/80 to-transparent"></div>
    <div class="container-x pb-14 pt-40 sm:pb-20">
      <p class="eyebrow text-frost hero-word inline-block" style="--d:0ms">Harare • Nationwide across Zimbabwe</p>
      <h1 class="display mt-5 max-w-5xl text-[12vw] font-extrabold leading-[0.92] sm:text-7xl lg:text-[6.75rem]">
        {headline.map((w, i) => <span class="hero-word inline-block" style={`--d:${120 + i * 70}ms`}>{w}&nbsp;</span>)}
      </h1>
      <div class="mt-8 grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
        <p class="max-w-xl text-lg text-white/80 hero-word" style="--d:700ms">Air conditioning, commercial refrigeration and plumbing. One team, for homes, developers and commercial premises.</p>
        <div class="flex flex-wrap gap-3 hero-word" style="--d:800ms">
          <a href={`tel:${site.phones[0].tel}`} class="btn-red">Call {site.phones[0].display}</a>
          <a href={waLink()} target="_blank" rel="noopener" class="btn-ghost">WhatsApp</a>
        </div>
      </div>
      <div class="mt-14 grid grid-cols-3 gap-6 border-t border-white/15 pt-6 text-sm hero-word" style="--d:950ms">
        <div><p class="display text-3xl font-bold sm:text-4xl">03</p><p class="text-white/60">Divisions</p></div>
        <div><p class="display text-3xl font-bold sm:text-4xl">HRE</p><p class="text-white/60">Based in Harare</p></div>
        <div><p class="display text-3xl font-bold sm:text-4xl">ZW</p><p class="text-white/60">Nationwide coverage</p></div>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="display bg-red py-4 text-sm font-bold uppercase tracking-[0.2em] text-white">
    <Marquee items={['Air Conditioning', 'Commercial Refrigeration', 'Plumbing', 'Projects', 'Procurement & Supplies']} speed="28s" sep="✦" />
  </div>

  <!-- SERVICES: three temperatures -->
  <div class="container-x pt-24 pb-10 sm:pt-32">
    <p class="eyebrow text-red" data-reveal>What we do</p>
    <h2 class="display mt-3 text-4xl font-extrabold leading-none sm:text-6xl" data-reveal style="--d:60ms">Three temperatures.<br />One team.</h2>
  </div>
  <ServicePanels panels={services} />

  <!-- ASSEMBLY -->
  <Assemble src="/images/crew.jpg" alt="KOTS technicians unloading an air-conditioning unit from a van" eyebrow="On site" title="One team. Every job." />

  <!-- WHO WE SERVE -->
  <section class="overflow-hidden border-y border-ink/10 py-16">
    <div class="container-x"><p class="eyebrow text-red" data-reveal>Who we serve</p>
      <h2 class="display mt-3 text-4xl font-extrabold leading-none sm:text-5xl" data-reveal style="--d:60ms">From a single home to a supermarket cold room.</h2></div>
    <div class="display mt-10 space-y-4 text-2xl font-bold sm:text-3xl">
      <Marquee items={clients.slice(0, 6)} speed="55s" />
      <Marquee items={clients.slice(6)} speed="60s" reverse class="text-ink/40" />
    </div>
  </section>

  <!-- COMMITMENT -->
  <section class="grain bg-ink text-white">
    <div class="container-x py-24 sm:py-32">
      <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-20">
        <div>
          <p class="eyebrow text-frost" data-reveal>Our commitment</p>
          <h2 class="display mt-4 text-4xl font-extrabold leading-[1] sm:text-5xl lg:text-6xl" data-reveal style="--d:60ms">Professional service. Dependable response. Quality work. Relationships that last.</h2>
          <div class="img-frame mt-10 aspect-[16/10]" data-reveal style="--d:120ms"><img src="/images/commercial.jpg" alt="Commercial air-conditioning plant" width="1200" height="750" loading="lazy" class="!h-[120%]" data-parallax="0.25" /></div>
        </div>
        <div class="grid gap-px overflow-hidden rounded-3xl bg-white/10 sm:grid-cols-2">
          {commitments.map((c, i) => (
            <div class="bg-ink p-7 sm:p-9" data-reveal style={`--d:${i * 70}ms`}>
              <p class="display text-sm font-bold text-red">0{i + 1}</p>
              <h3 class="display mt-3 text-2xl font-bold">{c.t}</h3>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaStrip />

  <!-- ENQUIRY -->
  <section id="enquiry" class="container-x grid gap-12 py-24 sm:py-32 lg:grid-cols-[1fr_1.2fr]">
    <div data-reveal>
      <p class="eyebrow text-red">Get a quote</p>
      <h2 class="display mt-3 text-4xl font-extrabold leading-none sm:text-5xl">Tell us what you need.</h2>
      <p class="mt-5 max-w-md text-ink/70">A few details and we call you back. Breakdown? Phone or WhatsApp.</p>
      <ul class="mt-8 space-y-2">
        {site.phones.map((p) => <li><a class="display text-2xl font-bold hover:text-red" href={`tel:${p.tel}`}>{p.display}</a></li>)}
        <li><a class="text-ink/70 underline-offset-4 hover:underline" href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
    <div class="rounded-[2rem] border border-ink/10 bg-white p-6 shadow-[0_30px_80px_-40px_rgba(9,12,24,.35)] sm:p-10" data-reveal style="--d:100ms"><EnquiryForm /></div>
  </section>
</Base>
