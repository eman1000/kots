---
import Base from '../layouts/Base.astro';
import ServiceHero from '../components/ServiceHero.astro';
import CtaStrip from '../components/CtaStrip.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Marquee from '../components/Marquee.astro';
import { site } from '../site';
import coldroomImg from '../assets/coldroom.jpg';
const coverage = ['Installation support', 'Preventative maintenance', 'Cleaning', 'Fault diagnosis', 'Component replacement', 'Breakdown response for commercial refrigeration equipment and cold-storage systems'];
const clients = ['Restaurants', 'Hotels', 'Supermarkets', 'Butcheries', 'Food outlets', 'Commercial kitchens', 'Beverage businesses', 'Cold-storage facilities'];
---
<Base title="Commercial Refrigeration Maintenance & Breakdown Response in Harare" description={`Commercial refrigeration installation support, preventative maintenance, fault diagnosis and breakdown response for supermarkets, butcheries, hotels, restaurants and cold rooms in Harare. Call ${site.phones[0].display}.`}>
  <ServiceHero eyebrow="Commercial refrigeration" title="Cold that you can count on." img={coldroomImg} alt="Technician inspecting a commercial cold room"
    lead="Cold rooms, display units and commercial kitchens. Maintained, repaired, back up fast." />

  <div class="display border-y border-ink/10 py-5 text-2xl font-bold sm:text-3xl"><Marquee items={clients} speed="45s" /></div>

  <section class="container-x py-20 sm:py-28">
    <p class="eyebrow text-red" data-reveal>Service coverage</p>
    <h2 class="display mt-3 text-4xl font-extrabold leading-none sm:text-5xl" data-reveal style="--d:60ms">What we cover</h2>
    <ol class="mt-12 grid gap-x-10 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
      {coverage.map((c, i) => (
        <li class="border-t-2 border-ink pt-5" data-reveal style={`--d:${i * 60}ms`}>
          <p class="display text-sm font-bold text-red">0{i + 1}</p>
          <p class="display mt-2 text-xl font-bold leading-snug">{c}</p>
        </li>
      ))}
    </ol>
  </section>

  <CtaStrip heading="Refrigeration breakdown or maintenance needed?" />

  <section id="enquiry" class="container-x py-24 sm:py-32">
    <h2 class="display text-4xl font-extrabold leading-none sm:text-5xl" data-reveal>Request a refrigeration quote</h2>
    <div class="mt-10 max-w-3xl rounded-[2rem] border border-ink/10 bg-white p-6 sm:p-10" data-reveal style="--d:80ms"><EnquiryForm service="Commercial Refrigeration" /></div>
  </section>
</Base>
